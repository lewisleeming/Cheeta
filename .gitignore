# Ignore directories generated by Composer
/bin
/drush/contrib
/vendor/
/docroot/core
/docroot/profiles
/docroot/modules/contrib
/docroot/themes/contrib
/.pnpm-store/

# Ignore sensitive information
/docroot/sites/*/settings*.php
/docroot/sites/development.services.yml
/docroot/sites/*/services*.yml
!/docroot/sites/*/settings.php
!/docroot/sites/*/settings.lando.php
!/docroot/sites/*/settings.ddev.php

# Ignore paths that contain user-generated content.
/docroot/sites/*/files/*
docroot/sites/*/files
docroot/sites/*/private
private

# Don't allow it to mark them as submodules
/vendor/**/.git
/docroot/**/.git
/drush/**/.git

# Ignore frontend / grunt packages
node_modules
*.css.map
*.js.map

# Ignore SimpleTest multi-site environment
/docroot/sites/simpletest

# Ignore IDE files
.idea/
.vscode/

# Ignore .env files as they are personal
/.env

# Ignore DB dumps
*.sql
*.sql.gz
*.mysql
*.mysql.gz

# Ignore local lando files.
.lando.local.yml
/compose.yml
php.local.ini
local.services.yml

.DS_Store

# Structurizr local storage
doc/.structurizr

# Python
__pycache__/
*.pyc
.env